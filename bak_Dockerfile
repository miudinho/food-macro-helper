FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Kopiowanie kodu aplikacji oraz bazy produktów
COPY app.py .
COPY foods.json .

# Utworzenie katalogu na dane persystentne
RUN mkdir -p /app/data

EXPOSE 8501

CMD ["streamlit", "run", "app.py","--logger.level=debug", "--server.address=0.0.0.0", "--server.port=8501", "--server.enableCORS=false", "--server.enableXsrfProtection=false"]

